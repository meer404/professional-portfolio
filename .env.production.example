# Copy this to `.env` on the Hostinger server and fill in the blanks.
# Never commit the real `.env` — it stays out of git (see .gitignore).

APP_NAME="Mir Mohammed — Portfolio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mir.codes

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Hostinger hPanel -> Databases -> MySQL Databases
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Sync keeps deployment simple (no queue worker/daemon to babysit on shared
# hosting) — fine for a low-volume contact form. Switch to `database` only if
# you also set up a cron entry running `queue:work --stop-when-empty`.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Hostinger hPanel -> Emails -> create the mailbox first, then use its
# credentials here. Host/port below are Hostinger's standard SMTP endpoint.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=contact@mir.codes
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@mir.codes"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
